{
 "name": "legacy-services",
 "description": "Legacy/cleartext servers & clients that should not be installed (CIS 2.x).  Absent keys/paths SKIP, never false-fail.",
 "rules": [
  {
   "id": "pack.absent/usr/sbin/telnetd",
   "title": "telnetd not installed",
   "kind": "path_exists",
   "path": "/usr/sbin/telnetd",
   "should_exist": false,
   "severity": "MEDIUM",
   "rationale": "A telnet server accepts cleartext logins over the network.",
   "fix": "Remove telnetd (legacy/insecure).",
   "refs": [
    "CIS Linux Benchmark 2.3"
   ]
  },
  {
   "id": "pack.absent/usr/sbin/in.telnetd",
   "title": "in.telnetd not installed",
   "kind": "path_exists",
   "path": "/usr/sbin/in.telnetd",
   "should_exist": false,
   "severity": "MEDIUM",
   "rationale": "inetd-style telnet server — cleartext logins.",
   "fix": "Remove in.telnetd (legacy/insecure).",
   "refs": [
    "CIS Linux Benchmark 2.3"
   ]
  },
  {
   "id": "pack.absent/usr/sbin/rshd",
   "title": "rshd not installed",
   "kind": "path_exists",
   "path": "/usr/sbin/rshd",
   "should_exist": false,
   "severity": "MEDIUM",
   "rationale": "rsh server: host-based trust + cleartext, a lateral-movement classic.",
   "fix": "Remove rshd (legacy/insecure).",
